# Copy to .env (or export in your shell) and fill in real values.
# The application fails to start if any required value below is missing
# (Requirement 10.4). No secret values are committed to source control.

# --- Database ---
OMS_DB_URL=jdbc:mysql://localhost:3306/omsdb
OMS_DB_USERNAME=root
OMS_DB_PASSWORD=change-me

# --- JWT signing secret ---
# Must be a strong, random value of at least 32 bytes for HMAC-SHA256.
OMS_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# --- Bootstrap admin (used by the V2 seed migration) ---
# OMS_BOOTSTRAP_ADMIN_USERNAME is optional (defaults to "admin").
# OMS_BOOTSTRAP_ADMIN_PASSWORD_HASH must be a BCrypt hash of the desired
# password. Generate one, for example, with:
#   Spring: new BCryptPasswordEncoder().encode("your-password")
OMS_BOOTSTRAP_ADMIN_USERNAME=admin
OMS_BOOTSTRAP_ADMIN_PASSWORD_HASH=$2a$10$replace-with-a-real-bcrypt-hash
