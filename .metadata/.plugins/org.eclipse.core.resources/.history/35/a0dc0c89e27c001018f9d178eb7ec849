package com.dmart.oms.notification.controller;

import java.util.List;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.dmart.oms.notification.model.OutboxEvent;
import com.dmart.oms.notification.repository.OutboxRepository;

//notification/controller/OutboxAdminController.java
@RestController
@RequestMapping("/api/admin/notifications")
public class OutboxAdminController {
	private final OutboxRepository repo;

	public OutboxAdminController(OutboxRepository repo) {
		this.repo = repo;
	}

	@GetMapping("/pending")
	public List<OutboxEvent> pending() {
		return repo.findTop100ByStatusOrderByCreatedAt("PENDING");
	}

	@PostMapping("/retry/{id}")
	public void retry(@PathVariable Long id) {
		repo.findById(id).ifPresent(e -> {
			e.setStatus("PENDING");
			repo.save(e);
		});
	}
}
