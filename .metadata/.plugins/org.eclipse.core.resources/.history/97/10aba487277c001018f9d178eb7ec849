import com.dmart.oms.order.repository.OrderRepository;

@Service
public class OrderService {

	private final OrderRepository repo;

	public OrderService(OrderRepository repo) {
		this.repo = repo;
	}

	public List<Order> getAllOrders() {
		return repo.findAll();
	}

