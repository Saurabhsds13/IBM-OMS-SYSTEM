package com.dmart.oms.shipping.model;

import jakarta.persistence.*;
import java.time.LocalDateTime;

@Entity
@Table(name = "shipment_events")
public class ShipmentEvent {
	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY)
	private Long id;

	private String description; // e.g. "Packed", "Out for Delivery"
	private LocalDateTime eventTime;

	@ManyToOne
	@JoinColumn(name = "shipment_id")
	private Shipment shipment;

	public Long getId() {
		return id;
	}

	public void setId(Long id) {
		this.id = id;
	}

	public String getDescription() {
		return description;
	}

	public void setDescription(String description) {
		this.description = description;
	}

	public LocalDateTime getEventTime() {
		return eventTime;
	}

	public void setEventTime(LocalDateTime eventTime) {
		this.eventTime = eventTime;
	}

	public Shipment getShipment() {
		return shipment;
	}

	public void setShipment(Shipment shipment) {
		this.shipment = shipment;
	}

	public ShipmentEvent(Long id, String description, LocalDateTime eventTime, Shipment shipment) {
		super();
		this.id = id;
		this.description = description;
		this.eventTime = eventTime;
		this.shipment = shipment;
	}

	public ShipmentEvent() {
		super();
		// TODO Auto-generated constructor stub
	}

	@Override
	public String toString() {
		return "ShipmentEvent [id=" + id + ", description=" + description + ", eventTime=" + eventTime + ", shipment="
				+ shipment + "]";
	}

}
