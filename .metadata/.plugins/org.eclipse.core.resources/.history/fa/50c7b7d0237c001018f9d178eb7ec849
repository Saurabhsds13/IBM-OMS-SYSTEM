package com.dmart.oms.analytics.controller;

import java.time.LocalDate;
import java.util.List;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.dmart.oms.analytics.dto.KpiResponse;
import com.dmart.oms.analytics.dto.TimeseriesPoint;
import com.dmart.oms.analytics.repository.DailySalesAggRepository;
import com.dmart.oms.analytics.repository.KpiSnapshotRepository;

//analytics/controller/AnalyticsController.java
@RestController
@RequestMapping("/api/admin/analytics")
public class AnalyticsController {
	private final DailySalesAggRepository dailyRepo;
	private final KpiSnapshotRepository kpiRepo;

	public AnalyticsController(DailySalesAggRepository d, KpiSnapshotRepository k) {
		this.dailyRepo = d;
		this.kpiRepo = k;
	}

	@GetMapping("/kpis")
	public KpiResponse getKpis() {
		var snap = kpiRepo.findTopByOrderByComputedAtDesc().orElseThrow();
		return new KpiResponse(snap.getComputedAt(), snap.getRevenueLast24h(), snap.getOrdersLast24h(),
				snap.getAovLast24h(), snap.getRefundRateLast7d(), snap.getFulfillmentSlaHitPct());
	}

	@GetMapping("/timeseries")
	public List<TimeseriesPoint> timeseries(@RequestParam LocalDate from, @RequestParam LocalDate to,
			@RequestParam(required = false) String vendor, @RequestParam(required = false) String product) {
		var rows = vendor != null ? dailyRepo.findByVendorNameAndDateBetween(vendor, from, to)
				: product != null ? dailyRepo.findByProductCodeAndDateBetween(product, from, to)
						: dailyRepo.findByDateBetween(from, to);
		return rows.stream().map(r -> new TimeseriesPoint(r.getDate(), r.getRevenue(), r.getOrders(), r.getAov(),
				r.getCancellations(), r.getBackorders())).toList();
	}

// Admin triggers
	@PostMapping("/rebuild/day")
	public void rebuildDay(@RequestParam LocalDate day) {
		/* delegate to service */ }

	@PostMapping("/backfill")
	public void backfill(@RequestParam LocalDate from, @RequestParam LocalDate to) {
		/* delegate */ }
}
